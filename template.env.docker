# Settings for running with Docker Compose. Copy to .env and fill in the two required values:
#   cp template.env.docker .env
# See docs/deploy.md.

# REQUIRED. The address the app is opened at, exactly as it appears in a browser:
# https://, the domain, no trailing slash. Feed and file links are built from it, and it is
# baked into the image when it is built, so after changing it run:
#   docker compose up -d --build
APP_URL=

# REQUIRED. Signs login sessions; anyone who knows it can sign in as any user.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# --- Optional -------------------------------------------------------------------------

# The port on this machine that the app answers on.
#APP_PORT=3000

# Who can reach that port. The default is this machine only, for a reverse proxy on the
# same host. 0.0.0.0 exposes it to the network.
#APP_BIND=127.0.0.1

# Where db.json and uploads/ are kept. The default is a Docker volume. Give a folder on the
# host instead (it must be writable by user id 1000), for example on a larger disk:
#DATA_MOUNT=/srv/ever-given-pod

# A new, empty database normally starts with no accounts. "true" creates the sample
# account from the README, whose password is public. Leave this alone on a real server.
#SEED_SAMPLE_DATA=false

# Only for the bundled HTTPS proxy (docker compose --profile caddy): the domain, no https://
#APP_DOMAIN=
